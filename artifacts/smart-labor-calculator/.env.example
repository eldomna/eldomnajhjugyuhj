# ---------------------------------------------------------------------------
# Smart Labor Calculator — environment template
# Copy to `.env` (local) or configure in your host's dashboard.
# Variables prefixed with VITE_ are PUBLIC (bundled into browser code).
# Everything else is server-only and must never be exposed.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=8080

# --- Database / Auth (Supabase, self-hosted or hosted) -----------------------
# Public (browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only (same values as above; the service role key is secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (optional; AI features degrade gracefully when unset) -------
# openai | anthropic | gemini | custom (any OpenAI-compatible endpoint)
AI_PROVIDER=openai
AI_API_KEY=
# Optional overrides
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# --- Deployment target (build-time only) ------------------------------------
# Nitro preset: node-server (default) | cloudflare-module | vercel | netlify | bun | deno-server
# NITRO_PRESET=node-server
